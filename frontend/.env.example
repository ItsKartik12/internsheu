# Base URL of the backend API. This is your deployed Render backend.
# On Vercel, set VITE_API_BASE_URL to this same value under
# Project Settings -> Environment Variables. If you don't set it there,
# src/services/api.js falls back to this exact URL automatically, so
# production still works even if the env var is missing.
VITE_API_BASE_URL=https://internsheu.onrender.com
