# Port the Express server listens on
PORT=5000

# MongoDB connection string used by all models.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/internsetu

# JWT secret — use a strong random string in production
JWT_SECRET=changeme_use_a_strong_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API. Defaults to
# http://localhost:5173 (the Vite dev server) if unset — see server.js.
CORS_ORIGIN=http://localhost:5173
