# ── InternSetu Backend — Environment Variables ────────────────────────────

PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/internsetu?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ── VJudge ── (contest/submission integration)
VJUDGE_USERNAME=
VJUDGE_PASSWORD=
VJUDGE_BASE_URL=https://vjudge.net

# ── Judge0 ── (real sandboxed code execution for [Run] button)
# NEVER expose these to the frontend.
#
# Option A — RapidAPI hosted Judge0 CE (free tier available):
#   Sign up: https://rapidapi.com/judge0-official/api/judge0-ce
#   JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=<your-rapidapi-key>
#
# Option B — Self-hosted Judge0 CE (Docker):
#   docker run -p 2358:3000 judge0/judge0-ce
#   JUDGE0_BASE_URL=http://localhost:2358
#   JUDGE0_API_KEY=   (leave blank for no-auth self-hosted)
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
