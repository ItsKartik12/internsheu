# Port the Express server listens on
PORT=5000

# Postgres connection string — not yet wired into the app; routes currently
# serve mock data. Point this at a real database when persistence is added.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Comma-separated list of origins allowed to call this API. Defaults to
# http://localhost:5173 (the Vite dev server) if unset — see server.js.
CORS_ORIGIN=http://localhost:5173
