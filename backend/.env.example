# ── InternSetu Backend — Environment Variables ────────────────────────────

PORT=5000

# MongoDB connection string used by all models.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/internsetu

# JWT secret — use a strong random string in production
JWT_SECRET=changeme_use_a_strong_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Google Gemini (AI Interviewer) — backend-only, never exposed to the frontend
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# AI provider switch (gemini is the default used by the AI Interviewer)
AI_PROVIDER=gemini

# Deepgram speech-to-text
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
