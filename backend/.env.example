# Port the Express server listens on
PORT=5000

# Postgres connection string — an earlier scaffolding placeholder, unused
# by the current models (see MONGODB_URI below).
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# MongoDB connection string used by models/User.js and models/CuratedContent.js.
# Not yet wired into server.js — see config/db.js.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/internsheu

# Comma-separated list of origins allowed to call this API. Defaults to
# http://localhost:5173 (the Vite dev server) if unset — see server.js.
CORS_ORIGIN=http://localhost:5173
